{
  "name": "bingo-arena-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Bingo Arena server: rooms, turn order, realtime match state",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test test/rooms.test.ts test/api.test.ts test/realtime.test.ts",
    "test:engine": "node --test ../shared/board.test.js ../shared/match.test.js",
    "test:all": "npm run test:engine && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "bingo",
    "socket.io",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
